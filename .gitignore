# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Claude Code local-only state (machine paths, local session cache)
.claude/settings.local.json
.claude/pr-sentinel-state.json
.claude/.headroom_wrap_*.json
.claude/.headroom_wrap_*.lock

# Vendored skill binaries (platform-specific, downloaded on first run)
.claude/skills/impeccable/scripts/bin/

docs/plans/

# Local agent/tooling state
# .agents skills are tracked so they exist in every git worktree (like
# .claude); keep only the platform binary and machine-local state out.
.agents/pr-sentinel-state.json
.agents/skills/impeccable/scripts/bin/
.mcp.json
.serena/
skills-lock.json

# Maven
target/

# Distribution build output
dist/
Distribution/.env

# Vaadin frontend build (generated by vaadin-maven-plugin / npm)
apps/api/node_modules/
apps/api/src/main/frontend/generated/
apps/api/src/main/bundles/
apps/api/frontend/generated/
apps/api/.vaadin/
apps/api/vite.generated.ts

# IDE
.idea/
*.iml
.vscode/
.settings/
.classpath
.project

# graphify knowledge graph output
graphify-out/

# Legacy app screenshots (reference only, not part of the build)
Legacy Screenshots/

# Session scratch files (briefs, logs) — not part of the build
scratch/

# Playwright MCP browser snapshots
.playwright-mcp/

# Scratchpad diff artifacts (temp paths mangled into filenames)
*scratchpad*.diff
