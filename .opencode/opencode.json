{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["./plugins/impeccable-hooks.ts"],
  "mcp": {
    "JavaDocs": { "type": "remote", "url": "https://www.javadocs.dev/mcp", "enabled": true },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "enabled": true,
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PAT}"
      }
    }
  }
}